# The retired ML prototype (analytics/) was removed on 2026-09-27; the DSS
# runs no Python. These rules only keep its generated files from coming
# back if the folder is ever restored from Git history.
/analytics/model_accuracy.txt
/analytics/temp_*.json

# Trained model artifacts. Candidates and archived models are local
# working state; an ACTIVE model is deployed deliberately, so add it with
# `git add -f analytics/models/active/` when one is genuinely promoted.
/analytics/models/candidate/
/analytics/models/archived/

# IDE helper files (barryvdh/laravel-ide-helper)
/_ide_helper.php
/_ide_helper_models.php
/.phpstorm.meta.php

# Database backups (contain live student data; timestamped dumps kept locally only)
/backups
/storage/backups

# Python bytecode cache
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
# Local secrets, uploads, and analytics scratch output
.env.*
!.env.example
/storage/app/temp_*.json
/storage/app/private/
/analytics/datasets/

# Learner-identifying mapping/analysis exports generated at the project
# root (e.g. term1_intervention_remedial_mapping.csv, 2026-09-21: LRNs,
# names, intervention ids). Never source; never committed. Real CSV
# inputs live under database/seeders/ and tests/Fixtures/, not here.
/*.csv
/term1_intervention_remedial_mapping.csv
